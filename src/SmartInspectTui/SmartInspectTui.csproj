<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>smartinspect-tui</AssemblyName>
    <RootNamespace>SmartInspectTui</RootNamespace>
    <Version>1.0.0</Version>
    <Product>SmartInspect TUI</Product>
    <Description>Cross-platform terminal user interface for SmartInspect live logs and .sil files</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartInspectConsole.Core\SmartInspectConsole.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.7" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
    <PackageReference Include="FuzzySharp" Version="2.0.2" />
    <PackageReference Include="Terminal.Gui" Version="1.17.1" />
  </ItemGroup>
</Project>
